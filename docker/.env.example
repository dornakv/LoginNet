# PostgreSQL Database Password
POSTGRES_PASSWORD=change_me_to_secure_password

# Make sure the password matches POSTGRES_PASSWORD above
# IMPORTANT: Use host.docker.internal to connect from dev container to PostgreSQL container running on host
ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=loginnetdb;Username=loginnetuser;Password=change_me_to_secure_password

# Generate key with: openssl rand -base64 32
Jwt__Key=REPLACE_WITH_GENERATED_256BIT_KEY
